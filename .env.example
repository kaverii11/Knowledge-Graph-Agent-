# Copy to .env and fill in. Never commit .env.

# --- LLM: OpenAI (default) ---
OPENAI_API_KEY=your_openai_api_key

# --- or any OpenAI-compatible API, e.g. Groq (free tier) ---
# LLM_API_KEY=your_groq_key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# FAST_MODEL=openai/gpt-oss-20b
# PRO_MODEL=openai/gpt-oss-120b
# QUERY_MODEL=openai/gpt-oss-120b
# JUDGE_MODEL=qwen/qwen3.8-27b
# EMBED_MODEL=none          # Groq has no embeddings; string similarity is used instead

# --- Neo4j (local Docker or Aura) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password

# --- Tracing (optional) ---
# MLFLOW_TRACING=0          # switch off MLflow tracing
